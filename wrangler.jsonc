{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "snug",
  "account_id": "d096b8fe68a089fd16032a88c0fd849b",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "snug",
      "database_id": "7f6b8d21-94ba-41b3-ad18-b20f3c84d1cb",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // "mock" = free canned AI answers (testing), "live" = real Claude calls
    "AI_MODE": "mock",
    // Max AI requests per day, protects the prepaid credit
    "AI_DAILY_LIMIT": "40"
  }
}
