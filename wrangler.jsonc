{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "snug",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "snug",
      // Fill in after `npx wrangler d1 create snug` (see README)
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // "mock" = free canned AI answers (testing), "live" = real Claude calls
    "AI_MODE": "mock",
    // Max AI requests per day, protects the prepaid credit
    "AI_DAILY_LIMIT": "40"
  }
}
